{
    "name": "profile-back",
    "version": "1.0.3",
    "description": "Stream Deck plugin: boards you can open from any profile, with Back and Board Back keys.",
    "license": "MIT",
    "private": true,
    "scripts": {
        "build": "node scripts/make-profiles.mjs && rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.caviarthecatgirl.profile-back\"",
        "profiles": "node scripts/make-profiles.mjs",
        "test": "node test/fake-deck.mjs"
    },
    "type": "module",
    "devDependencies": {
        "@elgato/cli": "^1.6.0",
        "@rollup/plugin-commonjs": "^28.0.0",
        "@rollup/plugin-node-resolve": "^15.2.2",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node20": "^20.1.2",
        "@types/node": "~20.15.0",
        "rollup": "^4.0.2",
        "tslib": "^2.6.2",
        "typescript": "^5.2.2"
    },
    "dependencies": {
        "@elgato/streamdeck": "^2.0.0"
    }
}
